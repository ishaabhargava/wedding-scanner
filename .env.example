# ========================================================
# Wedding Photo-Sharing Platform - Environment Configuration
# ========================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with real credentials to version control.

# --------------------------------------------------------
# 1. Server Configuration
# --------------------------------------------------------
PORT=5001
NODE_ENV=development

# URL of the React frontend application (for CORS and OAuth redirect targets)
# Local development: http://localhost:3000
# Production: https://your-wedding-domain.vercel.app
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------
# 2. Google Cloud OAuth 2.0 Credentials
# --------------------------------------------------------
# Obtain these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Authorized redirect URI.
# Must match the Authorized Redirect URI added in Google Cloud Console.
# Local development: http://localhost:5001/api/auth/google/callback
# Production: https://your-backend-service.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Optional: Default Google Drive folder ID (leave blank to let organizer create or choose via admin dashboard)
GOOGLE_DRIVE_FOLDER_ID=

# --------------------------------------------------------
# 3. Security & Admin Authentication
# --------------------------------------------------------
# Password used by the wedding organizer to log into the admin dashboard (/admin)
# Change this to a secure passphrase for production!
ADMIN_PASSWORD=wedding2025

# Secret key used to sign JWT tokens for admin sessions
# Generate a random 64-character string for production (e.g., using `openssl rand -hex 32`)
JWT_SECRET=replace-this-with-a-random-secure-secret-key-at-least-32-characters

# 256-bit AES encryption key used to encrypt the Google OAuth refresh token on disk
# Generate a random string or passphrase
ENCRYPTION_KEY=replace-with-a-secure-encryption-passphrase-at-least-32-chars

# --------------------------------------------------------
# 4. Upload Limits & Media Configuration
# --------------------------------------------------------
# Maximum number of photos allowed in a single guest upload session (default 30)
MAX_FILES_PER_UPLOAD=30

# Maximum file size per photo in Megabytes (default 70 MB)
MAX_FILE_SIZE_MB=70

# Local data directory for persistent configuration, token storage, and upload logs
# Defaults to "./data" inside the server directory
DATA_DIR=./data
